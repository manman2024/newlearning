{
  "name": "mkfast-template",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "e2e": "playwright test",
    "e2e:production": "playwright test --config playwright.production.config.ts",
    "e2e:stripe": "tsx scripts/run-stripe-e2e.ts",
    "e2e:creem": "tsx scripts/run-creem-e2e.ts",
    "e2e:waffo": "tsx scripts/run-waffo-e2e.ts",
    "e2e:install": "playwright install",
    "e2e:ui": "playwright test --ui",
    "test": "pnpm locale:compile && vitest run",
    "test:watch": "pnpm locale:compile && vitest",
    "knip": "knip",
    "check": "pnpm lint && pnpm test && pnpm build && pnpm typecheck && pnpm e2e",
    "check:production": "pnpm e2e:production",
    "lint": "biome check",
    "typecheck": "pnpm locale:compile && pnpm content:build && tsc --noEmit",
    "content:build": "tsx scripts/build-content-collections.ts",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "locale:sort": "tsx scripts/sort-locale-keys.ts",
    "locale:check": "tsx scripts/check-locale-keys.ts",
    "locale:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/locale/paraglide --strategy url cookie baseLocale --emit-ts-declarations --is-server 'import.meta.env?.SSR === true'",
    "deploy": "pnpm run build && wrangler deploy",
    "postinstall": "pnpm run cf-typegen",
    "assets:generate": "tsx scripts/generate-image-assets.ts",
    "email:dev": "pnpm run locale:compile && email dev --dir src/mail/templates --port 3333",
    "sync-github-secrets": "tsx scripts/sync-github-secrets.ts",
    "sync-worker-secrets": "wrangler secret bulk .env.production",
    "cf-typegen": "wrangler types --env-interface Env",
    "auth:schema:generate": "NODE_OPTIONS='--require tsconfig-paths/register' auth generate --yes --output src/db/auth.schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio:local": "drizzle-kit studio --config drizzle.config.local.ts",
    "db:studio:remote": "drizzle-kit studio --config drizzle.config.ts",
    "db:sync:local": "tsx scripts/sync-d1-remote-to-local.ts",
    "db:admin:local": "tsx scripts/set-admin.ts --local",
    "db:admin:remote": "tsx scripts/set-admin.ts --remote",
    "db:migrate:local": "wrangler d1 migrations apply $(tsx scripts/get-db-name.ts) --local",
    "db:migrate:remote": "wrangler d1 migrations apply $(tsx scripts/get-db-name.ts) --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@beehiiv/sdk": "^0.1.9",
    "@better-auth/api-key": "1.6.33",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@fontsource/bricolage-grotesque": "^5.2.10",
    "@hookform/resolvers": "^5.9.2",
    "@inlang/paraglide-js": "^2.29.0",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.7",
    "@t3-oss/env-core": "^0.13.10",
    "@tabler/icons-react": "^3.36.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "0.14.0",
    "@tanstack/ai-fal": "^0.7.0",
    "@tanstack/ai-react": "0.8.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-table": "^8.21.2",
    "@waffo/pancake-ts": "0.21.0",
    "better-auth": "~1.6.33",
    "better-auth-harmony": "^1.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "creem": "^1.4.4",
    "crisp-sdk-web": "^1.0.27",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "nanoid": "^5.1.16",
    "nuqs": "^2.8.8",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "resend": "^6.9.2",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.7",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.6",
    "unified": "^11.0.5",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@>=1.0.0 <1.19.17": "1.19.17",
      "@modelcontextprotocol/sdk@>=1.0.0 <1.32.1": "1.32.1",
      "ajv@>=8.0.0 <8.20.0": "8.20.0",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "defu@>=6.0.0 <6.1.7": "6.1.7",
      "express-rate-limit@>=8.0.0 <8.7.1": "8.7.1",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "hono@>=4.0.0 <4.13.13": "4.13.13",
      "ip-address@>=10.0.0 <10.7.4": "10.7.4",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "lodash@>=4.0.0 <4.18.1": "4.18.1",
      "minimatch@>=10.0.0 <10.2.6": "10.2.6",
      "next@16.1.7>sharp": "0.35.5",
      "path-to-regexp@>=8.0.0 <8.4.2": "8.4.2",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.7": "4.0.7",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "7.1.6",
      "postcss@>=8.0.0 <8.5.30": "8.5.30",
      "proxy-addr@>=2.0.0 <2.0.8": "2.0.8",
      "qs@>=6.0.0 <6.16.1": "6.16.1",
      "seroval": "1.6.8",
      "smol-toml@>=1.0.0 <1.9.1": "1.9.1",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "svix@>=1.0.0 <1.99.1": "1.99.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "ws@>=8.0.0 <8.22.0": "8.22.0",
      "yaml@>=2.0.0 <2.9.1": "2.9.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@content-collections/core": "^0.13.1",
    "@content-collections/vite": "^0.3.1",
    "@playwright/test": "^1.62.0",
    "@react-email/preview-server": "5.2.10",
    "@tanstack/devtools-vite": "^0.8.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "auth": "1.6.33",
    "drizzle-kit": "^0.31.10",
    "knip": "^5.84.1",
    "react-email": "5.2.10",
    "sharp": "0.35.5",
    "tsconfig-paths": "4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "4.1.12",
    "wrangler": "^4.151.1"
  }
}
